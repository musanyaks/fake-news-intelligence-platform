# Application
APP_NAME=fake-news-intelligence-platform
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fakenews
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_NEWS=news-articles
KAFKA_TOPIC_PREDICTIONS=predictions
KAFKA_CONSUMER_GROUP=fake-news-consumer

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fake-news-detection
MLFLOW_MODEL_REGISTRY_URI=models:/fake-news-model/production

# Spark
SPARK_MASTER_URL=local[*]
SPARK_APP_NAME=fake-news-pipeline

# AWS (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=fake-news-data

# Model
MODEL_PATH=models/
DEFAULT_MODEL_VERSION=latest

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
EVIDENTLY_PORT=8085

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Evidence APIs (get keys from Google Cloud Console)
GOOGLE_FACT_CHECK_API_KEY=your-fact-check-api-key-here
GOOGLE_SEARCH_API_KEY=your-custom-search-api-key-here
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id-here
# Get Search Engine ID at: https://programmablesearchengine.google.com
# Get API keys at: https://console.cloud.google.com/apis/credentials
